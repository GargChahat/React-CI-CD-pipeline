pipeline{
    agent any
     options{
        skipDefaultCheckout()
    }

    stages{
        stage('Clean'){
            steps{
                cleanWs()
            }
        }
        stage('Checkout'){
            steps{
                checkout scm
            }
        }
        stage('Build'){
            agent{
                docker{
                    image 'node:18-alpine'
                    args '-u root'
                    reuseNode true
                }
            }
        
            steps{
                 sh '''
                 ls -l
                 node --version
                 npm --version
                 npm install
                 npm run build
                 ls -l
                 '''
            }
        }
    }
}