pipeline {
    agent any

    options {
        skipDefaultCheckout()
    }

    stages {
        stage('Clean') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            agent {
                docker {
                    image 'node:22-alpine'
                    args '-u root'
                    reuseNode true
                }
            }

            steps {
                sh '''
                    echo "Node version:"
                    node --version

                    echo "Platform:"
                    node -p "process.platform + ' ' + process.arch"

                    echo "Removing old dependencies:"
                    rm -rf node_modules

                    echo "Installing dependencies:"
                    npm ci --include=optional

                    echo "Building React:"
                    npm run build

                    ls -lh dist
                '''
            }
        }
        
        stage('Test'){
            docker {
                    image 'node:22-alpine'
                    args '-u root'
                    reuseNode true
                }

                steps {
                    sh '''
                        echo "Running tests:"
                        npm test
                    '''
                }
        }
    
    }
}