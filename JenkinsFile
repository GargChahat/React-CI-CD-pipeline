pipeline{
    agent any
     
    stages{
        stage('Build'){
            agent{
                docker{
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            environment {
                HOME = '/tmp'
                npm_config_cache = '/tmp/npm-cache'
            }
            steps{
                 sh '''
                 ls -l
                 node --version
                 npm --version
                 npm install
                 npm run build
                 ls -l
                 '''
            }
        }
    }
}