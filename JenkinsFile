pipeline{
    agent any
    environment {
        PATH = "/Users/chahatgarg/.docker/bin:/opt/homebrew/bin:/usr/local/bin:${env.PATH}"
    }
    stages{
        stage('Build'){
            agent{
                docker{
                    image 'node:18-alpine'
                    reuseNode true
                }
            }
            steps{
                 sh '''
                 ls -l
                 node --version
                 npm --version
                 npm install
                 npm run build
                 ls -l
                 '''
            }
        }
    }
}